# ==============================================================================
# 1. AI MODELS & WEIGHTS (Never commit gigabytes of binary artifacts)
# ==============================================================================
*.bin
*.pt
*.pth
*.ckpt
*.onnx
*.gguf
*.safetensors
*.h5
*.pb
models/
checkpoint*/

# ==============================================================================
# 2. DATASETS & VECTOR STORES (Prevent tracking raw data or local db volumes)
# ==============================================================================
data/
datasets/
*.csv
*.jsonl
*.parquet
*.pickle
*.pkl

# Vector Databases / Local DBs
.chroma/
*.sqlite
*.duckdb
.neo4j/
milvus_data/

# ==============================================================================
# 3. CRITICAL SECRETS & API KEYS (LLM API keys, Cloud credentials)
# ==============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.token
secrets/
.aws/
.gcloud/

# ==============================================================================
# 4. AI EDITORS, AGENTS & IDE CACHES (Cursor, Claude Code, etc.)
# ==============================================================================
# Ignore individual editor index caches but track shared prompts/rules if needed
.cursorindexingignore
.cursor/
!.cursor/rules/
.claude/
!.claude/commands/
.agents/

# Standard IDEs
.vscode/
.idea/
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ==============================================================================
# 5. PYTHON DEPENDENCIES & RUNTIMES
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.ruff_cache/
.pytest_cache/

# ==============================================================================
# 6. LOGS & EXPERIMENT TRACKING
# ==============================================================================
*.log
logs/
wandb/
mlruns/
lightning_logs/
.venv
pyproject.toml
